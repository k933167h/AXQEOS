{
 "name": "axqeos",
 "python": "3.12",
 "requirements": ["requirements.txt"],
 "exclude_runtime": ["pytest"],
 "test_requirements": ["requirements.txt"],
 "tests": [
  {"name": "pytest", "cmd": ["{python}", "-m", "pytest", "-q", "tests"]}
 ],
 "smoke": [
  {"name": "api /health", "cmd": ["{python}", "-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "18080"], "url": "http://127.0.0.1:18080/health", "timeout": 30}
 ],
 "selftest_env": {
  "AX_DB_PATH": "/tmp/axqeos-selftest.sqlite3",
  "AX_REPORTER_TOKEN": "selftest-reporter-token-0123456789",
  "AX_SME_TOKEN": "selftest-sme-token-0123456789abcd"
 },
 "images": [{"name": "axqeos-api", "dockerfile": "Dockerfile", "context": "."}],
 "external_images": ["prom/prometheus:v3.2.1", "grafana/grafana:11.5.2", "otel/opentelemetry-collector:0.123.0"],
 "url_env": ["JEV_BASE_URL", "LLM_JUDGE_BASE_URL", "PLANE_ISSUE_URL", "KIWI_RESULT_URL", "LANGFUSE_INGEST_URL", "AXQEOS_URL"],
 "secret_env": [
  {"name": "AX_REPORTER_TOKEN", "forbidden": ["replace-with-long-random-secret"], "min_length": 24},
  {"name": "AX_SME_TOKEN", "forbidden": ["replace-with-different-long-random-secret"], "min_length": 24}
 ],
 "license_deny": ["AGPL", "SSPL", "BUSL", "Elastic License", "Commons Clause"],
 "allowed_hosts": [],
 "notes": "LLM Judge(JEV_*, LLM_JUDGE_*)는 폐쇄망 내부 OpenAI 호환 엔드포인트(vLLM·Ollama)를 가리켜야 한다. Grafana 11.x는 AGPL-3.0이므로 수정 없이 내부 관측용으로만 쓴다."
}
